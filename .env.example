# Reddit OAuth app (https://www.reddit.com/prefs/apps, type "script"); read-only, app-only token
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit account that owns the app (goes into the User-Agent as required by the API rules)
REDDIT_USERNAME=

# Telegram notifications (optional): create bot via @BotFather, get chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Who to ping in the Telegram chat when the pipeline breaks: "@username" or numeric user id
TELEGRAM_ALERT_MENTION=

# OpenRouter — LLM second opinion on every candidate post
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
